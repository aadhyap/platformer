pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main functions

function _init()
	cls()
	init_player(42,60)
	mode="start"
	init_game()
	
end

function _update()

		if mode=="start" then
			update_player()
			cx = ((p.x-64)+(cx*9)) /10
			if (cx < 0 ) cx = 0
		
		elseif mode=="levelover" then
			next_level()
			if btnp(❎) then
				mode = "start"
			end
		end
end


function _draw()
	cls()
	camera(cx,cy)
	map(0,0)
	
	draw_player()
	
	if mode=="levelover" then
		-- draw_levelover()
	
	end

end

function col(x,y)

		return fget(
			mget(x/8, y/8),0
		)
end








-->8
-- player functions

function init_player(srt_x, srt_y)

	p = {
		x =srt_x,
		y =srt_y,
		dx = 0,
		dy = 0,
		g = false,
		flipped = false,
	}
	frame=1
	gravity = 1.3
	
end

function update_player()
	
	if (btn(⬅️)) then
		p.flipped = true
		p.dx -= 0.2
		animate(7,9,0.2)
	end
	
	if (btn(➡️)) then
		p.flipped = false
		p.dx += 0.2
		animate(7,9,0.2)
	end
	
	if btnp(⬆️) or btnp(🅾️) then
		if p.g then
			animate(33,35,0.2)
			sfx(3)
			p.dy = -gravity
		end
	end
	
	if not btnp(⬆️) and not btnp(🅾️)
	and not (btn(➡️)) and not (btn(⬅️))
	then
		animate(1,6,0.2)
	end
	
	p.y += p.dy
	p.dx *= 0.8 
	p.dy += 0.09
	cx = 0
	cy = 0
	
	if level_finished(p.x+7,p.y) then
		mode = "levelover"
	end
	
		if col(p.x,p.y+8)
		or col(p.x+7, p.y+8) then
			if not p.g then
				sfx(4)
				animate(49,54,0.01)
			end
			p.dy = 0 
			p.g = true
		else
			p.g = false
			p.land = false
		end

	
	--bump the clipped pixel up
	if col(p.x,p.y+7)
	and col(p.x+7, p.y+7) then
	p.y -= 1
	end
	
	if col(p.x+7, p.y+7) then
	p.x -= 1
	end
	
	if col(p.x, p.y+7) then
	p.x +=  1
	end
	
	
	
	if p.dx > 0 then 
		if not col(p.x+8, p.y+7) then
			p.x += p.dx
		end
	end
	
	if p.dx < 0 then 
		if not col(p.x-1, p.y+7) then
			p.x += p.dx
		end
	end
	
end


function draw_player()
	spr(frame,p.x,p.y,1,1,p.flipped)
	--pset(p.x-1,p.y+7,7)
end


function animate(start, 
end_frame, speed)
	
	if frame == 7 and p.g then
	 sfx(5)
	end
	if frame < start then
	 frame = start
	end
	if frame<end_frame - speed
	 then
			frame+=speed
		else
			frame=start
		end
end


-->8
--game helper

function init_game()

	location = {
	{0,0},
	{21,11}
	}
	
	
	level_struct = {
		x = 0,
		y = 0,
		name = "x1"
	}
	levels = {}
	levels[1]= "x1"
	levels[2]= "x2"
	levelnum = 1
	level = levels[levelnum]

end

function draw_gamveover()
	rectfill(0,60,128,75,0)
	print("game over", 46, 62,7)
	print("press ❎ to restart", 27)
	
end

function draw_levelover()
	rectfill(0,60,128,75,0)
	print("stage clear", 46, 62,7)
	print("press ❎ to continue",27,68,6)
	
end

function next_level()

	levelnum +=1
	
	if levelnum > 2 then
	
	-- endgame 
	
	else
		sfx(6)
		level = levels[levelnum]
		
		next_location = 
		location[levelnum]
		 
		p.x = next_location[1]
		p.y = next_location[2]
		--init_player(next_location[0],
		--next_location[1])
		spr(frame,p.x,p.y,1,1,p.flipped)
		map(next_location[1],
		next_location[2])
		
	end
end



function level_finished(x,y)
	return fget(
		mget(x/8, y/8),1
	)

end
