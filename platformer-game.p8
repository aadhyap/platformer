pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main functions

function _init()
	init_player()
end


function _update()
	update_player()
	cx = ((p.x-64)+(cx*9)) /10
	if (cx < 0 ) cx = 0
end


function _draw()
	cls()
	camera(cx,cy)
	map(0,0)
	
	draw_player()

end

function col(x,y)
	return fget(
		mget(x/8, y/8),0
		
	)
end






-->8
-- player functions

function init_player()

	p = {
		x =42,
		y =60,
		dx = 0,
		dy = 0,
		g = false,
		flipped = false,
	}
	frame=1
	gravity = 1.3
	
end

function update_player()
	
	if (btn(⬅️)) then
		p.flipped = true
		p.dx -= 0.2
		animate(7,9,0.2)
	end
	
	if (btn(➡️)) then
		p.flipped = false
		p.dx += 0.2
		animate(7,9,0.2)
	end
	
	if btnp(⬆️) or btnp(🅾️) then
		if p.g then
			animate(33,35,0.2)
			sfx(3)
			p.dy = -gravity
		end
	end
	
	if not btnp(⬆️) and not btnp(🅾️)
	and not (btn(➡️)) and not (btn(⬅️))
	then
		animate(1,6,0.2)
	end
	
	p.y += p.dy
	p.dx *= 0.8 
	p.dy += 0.09
	cx = 0
	cy = 0
	
	
	if col(p.x,p.y+8)
	or col(p.x+7, p.y+8) then
		if not p.g then
			sfx(4)
			animate(49,54,0.01)
		end
		p.dy = 0 
		p.g = true
	else
		p.g = false
		p.land = false
	end
	
	--bump the clipped pixel up
	if col(p.x,p.y+7)
	and col(p.x+7, p.y+7) then
	p.y -= 1
	end
	
	if col(p.x+7, p.y+7) then
	p.x -= 1
	end
	
	if col(p.x, p.y+7) then
	p.x +=  1
	end
	
	
	if p.dx > 0 then 
		if not col(p.x+8, p.y+7) then
			p.x += p.dx
		end
	end
	
	if p.dx < 0 then 
		if not col(p.x-1, p.y+7) then
			p.x += p.dx
		end
	end
	
end

function draw_player()
	spr(frame,p.x,p.y,1,1,p.flipped)
	--pset(p.x-1,p.y+7,7)
end


function animate(start, 
end_frame, speed)
	
	if frame == 7 and p.g then
	 sfx(5)
	end
	if frame < start then
	 frame = start
	end
	if frame<end_frame - speed
	 then
			frame+=speed
		else
			frame=start
		end
end


